1. Python program (app.py)

import ollama

print("AI BLOG CONTENT GENERATOR")

# Get user input
topic = input("Enter blog topic: ")
style = input("Enter writing style (Formal/Casual/Informative): ")

# Create prompt
prompt = f"""
Write a blog on the topic: {topic}.

Use this writing style: {style}.

Include:
1. An attractive title
2. Introduction
3. Main content with headings
4. Conclusion

Write the blog in simple and clear language.
"""

# Connect to Ollama
response = ollama.chat(
    model="qwen2.5:7b",
    messages=[
        {"role": "user", "content": prompt}
    ]
)

blog = response["message"]["content"]

# Display generated blog
print("\nGENERATED BLOG:\n")
print(blog)

# Save blog in text file
with open("blog.txt", "w", encoding="utf-8") as file:
    file.write(blog)

print("\nBlog saved successfully as blog.txt")


